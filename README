            <!-- Main Operational Dashboard -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                
                <!-- Quick Scanner & Actions Card -->
                <div class="bg-kazyonCard border border-zinc-800 p-5 rounded-2xl space-y-4 md:col-span-1">
                    <h3 class="font-bold text-white text-sm flex items-center gap-2">📷 ماسح الباركود السريع</h3>
                    <div class="space-y-3">
                        <button @click="startScanner" class="w-full bg-kazyonOrange hover:bg-kazyonOrangeHover text-white font-bold py-3.5 rounded-xl transition min-h-[55px] text-sm shadow-md">
                            فتح الكاميرا للمسح
                        </button>
                        <input type="text" x-model="searchQuery" @input.debounce.300ms="searchProduct" placeholder="أو ابحث برقم الباركود / الاسم..." 
                            class="w-full bg-zinc-900 border border-zinc-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-kazyonOrange">
                    </div>

                    <!-- Admin Only Bulk Upload -->
                    <template x-if="currentUser.role === 'admin'">
                        <div class="pt-4 border-t border-zinc-800 space-y-3">
                            <h3 class="font-bold text-white text-sm">📊 رفع شيت جماعي (.xlsx / .pdf)</h3>
                            <input type="file" @click.stop @change="handleFileUpload" accept=".xlsx, .xls, .pdf" class="w-full text-xs text-zinc-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-zinc-800 file:text-kazyonOrange hover:file:bg-zinc-700 cursor-pointer">
                        </div>
                    </template>
                </div>

                <!-- Product Display & Results Grid -->
                <div class="bg-kazyonCard border border-zinc-800 p-5 rounded-2xl md:col-span-2 space-y-4">
                    <div class="flex items-center justify-between">
                        <h3 class="font-bold text-white text-sm">📦 قاعدة بيانات المنتجات الحية</h3>
                        <span class="text-xs bg-zinc-800 text-zinc-400 px-3 py-1 rounded-full" x-text="products.length + ' منتج متاح'"></span>
                    </div>

                    <!-- Scanner Viewfinder Modal / Area -->
                    <div x-show="showScanner" class="bg-zinc-900 p-4 rounded-xl border border-zinc-700 text-center space-y-3">
                        <div id="reader" class="overflow-hidden rounded-lg"></div>
                        <button @click="stopScanner" class="bg-red-600/20 text-red-400 border border-red-500/30 px-4 py-2 rounded-xl text-xs font-bold">إغلاق الكاميرا</button>
                    </div>

                    <!-- Products List Grid -->
                    <div class="space-y-3 max-h-[450px] overflow-y-auto pr-1">
                        <template x-for="product in filteredProducts" :key="product.id">
                            <div class="bg-zinc-900/80 border border-zinc-800 p-4 rounded-xl flex items-center justify-between gap-4">
                                <div class="space-y-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-white font-bold text-sm" x-text="product.name"></span>
                                        <span class="text-xs bg-kazyonOrange/20 text-kazyonOrange px-2 py-0.5 rounded" x-text="product.category"></span>
                                    </div>
                                    <p class="text-xs text-zinc-400">الباركود: <span class="font-mono text-zinc-200" x-text="product.barcode"></span></p>
                                    <div class="flex gap-4 text-xs pt-1">
                                        <span class="text-zinc-300">مخزن: <strong class="text-white" x-text="product.warehouseQty"></strong></span>
                                        <span class="text-zinc-300">صالة: <strong class="text-white" x-text="product.hallQty"></strong></span>
                                        <span class="text-emerald-400">السعر: <strong x-text="product.price + ' ج.م'"></strong></span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button @click="adjustQty(product.id, 'hallQty', 1)" class="w-10 h-10 bg-zinc-800 hover:bg-zinc-700 text-white rounded-xl font-bold text-sm flex items-center justify-center">+</button>
                                    <button @click="adjustQty(product.id, 'hallQty', -1)" class="w-10 h-10 bg-zinc-800 hover:bg-zinc-700 text-white rounded-xl font-bold text-sm flex items-center justify-center">-</button>
                                </div>
                            </div>
                        </template>
                        <p x-show="products.length === 0" class="text-center text-zinc-500 text-xs py-8">لا توجد منتجات مسجلة حالياً. أضف منتجاً أو ارفع شيت البيانات.</p>
