                                <template x-for="log in activityLogs">
                                    <tr class="border-b border-zinc-800">
                                        <td class="p-3 font-semibold text-white" x-text="log.user"></td>
                                        <td class="p-3 font-mono text-kazyonOrange" x-text="log.ip"></td>
                                        <td class="p-3 text-zinc-500" x-text="log.time"></td>
