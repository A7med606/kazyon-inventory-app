    <!-- Application Script Logic -->
    <script>
        function kazyonApp() {
            return {
                isLoggedIn: false,
                currentUser: { role: '', username: '' },
                loginForm: { username: '', password: '' },
                loginError: '',
                searchQuery: '',
                showScanner: false,
                products: [],
                activityLogs: [],
                clientIp: '192.168.1.' + Math.floor(Math.random() * 200 + 10),
                
                get whatsappLink() {
                    let msg = encodeURIComponent("السلام عليكم، أرغب في طلب حساب خاص للوصول إلى نظام إدارة مخزون كازيون.");
                    return `https://wa.me/201016558430?text=${msg}`;
                },

                init() {
                    // Offline First Cache load
                    const cached = localStorage.getItem('kazyon_products');
                    if (cached) {
                        this.products = JSON.parse(cached);
                    } else {
                        this.products = [
                            { id: 1, barcode: '6221234567890', name: 'جبنة فريكو 500جم', category: 'ألبان', warehouseQty: 45, hallQty: 12, price: 45.00 },
                            { id: 2, barcode: '6229876543210', name: 'مسحوق اتوماتيك 2كجم', category: 'منظفات', warehouseQty: 20, hallQty: 8, price: 95.50 }
                        ];
                    }
                },

                handleLogin() {
                    this.loginError = '';
                    if (this.loginForm.username === 'General' && this.loginForm.password === '6060') {
                        this.currentUser = { role: 'admin', username: 'General' };
                        this.isLoggedIn = true;
                        this.logActivity('General', this.clientIp);
                    } else if (this.loginForm.username === 'admin' && this.loginForm.password === '123') {
                        this.currentUser = { role: 'staff', username: 'admin' };
                        this.isLoggedIn = true;
                        this.logActivity('admin (Staff)', this.clientIp);
                    } else {
                        this.loginError = 'اسم المستخدم أو كلمة المرور غير صحيحة.';
                    }
                },

                logout() {
                    this.isLoggedIn = false;
                    this.loginForm = { username: '', password: '' };
                },

                logActivity(user, ip) {
                    this.activityLogs.unshift({
                        user: user,
                        ip: ip,
                        time: new Date().toLocaleTimeString('ar-EG')
                    });
                },

                get filteredProducts() {
                    if (!this.searchQuery) return this.products;
                    return this.products.filter(p => 
                        p.name.toLowerCase().includes(this.searchQuery.toLowerCase()) || 
                        p.barcode.includes(this.searchQuery)
                    );
                },

                adjustQty(id, field, val) {
                    const product = this.products.find(p => p.id === id);
                    if (product) {
                        product[field] = Math.max(0, product[field] + val);
                        this.saveToStorage();
                    }
                },

                saveToStorage() {
                    localStorage.setItem('kazyon_products', JSON.stringify(this.products));
                },

                startScanner() {
                    this.showScanner = true;
                    setTimeout(() => {
                        const html5QrCode = new Html5Qrcode("reader");
                        html5QrCode.start(
                            { facingMode: "environment" },
                            { fps: 10, qrbox: { width: 250, height: 150 } },
                            (decodedText) => {
                                this.searchQuery = decodedText;
                                html5QrCode.stop();
                                this.showScanner = false;
                            },
                            (error) => {}
                        ).catch(err => {
                            alert("تعذر الوصول للكاميرا. تأكد من إعطاء إذن السماح.");
                            this.showScanner = false;
                        });
                    }, 300);
                },

                stopScanner() {
                    this.showScanner = false;
                },

                handleFileUpload(event) {
                    const file = event.target.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const data = new Uint8Array(e.target.result);
                        const workbook = XLSX.read(data, { type: 'array' });
                        const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                        const rows = XLSX.utils.sheet_to_json(firstSheet);
                        
                        rows.forEach((r, idx) => {
                            this.products.push({
                                id: Date.now() + idx,
                                barcode: String(r.Barcode || r.باركود || 'N/A'),
                                name: String(r.Name || r.الاسم || 'منتج جديد'),
                                category: String(r.Category || r.القسم أو الفئة || 'عام'),
                                warehouseQty: Number(r.Warehouse || r.المخزن || 10),
                                hallQty: Number(r.Hall || r.الصالة || 5),
                                price: Number(r.Price || r.السعر || 0)
                            });
                        });
                        this.saveToStorage();
                        alert("تم استيراد الملف وإضافة المنتجات بنجاح!");
                    };
                    reader.readAsArrayBuffer(file);
                }
            }
        }
    </script>
</body>
